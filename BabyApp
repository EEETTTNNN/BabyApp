<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Suivi Bébé</title>
  
  <!-- PWA Metadata -->
  <link rel="manifest" href="manifest.json">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="theme-color" content="#3b82f6">

  <!-- Tailwind CSS (Design) -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 font-sans text-gray-800 antialiased selection:bg-blue-200">

  <div id="app" class="max-w-md mx-auto min-h-screen bg-white flex flex-col shadow-xl pb-20">
    
    <!-- En-tête Profil -->
    <header class="p-6 bg-blue-500 text-white rounded-b-3xl text-center shadow-md relative">
      <div class="w-20 h-20 bg-white/20 rounded-full mx-auto flex items-center justify-center text-4xl mb-2 backdrop-blur-sm">
        👶
      </div>
      <h1 class="text-2xl font-extrabold tracking-wide">Suivi Bébé</h1>
      
      <div class="flex justify-around mt-4 pt-3 border-t border-white/20 text-sm">
        <div>
          <span class="block text-blue-200 text-xs">Dernier poids</span>
          <span id="stat-weight" class="font-bold">-- kg</span>
        </div>
        <div>
          <span class="block text-blue-200 text-xs">Taille</span>
          <span id="stat-height" class="font-bold">-- cm</span>
        </div>
      </div>
    </header>

    <!-- Boutons d'ajout rapide (Saisie d'événement) -->
    <section class="p-4">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">Ajouter une activité</h2>
      <div class="grid grid-cols-3 gap-3">
        
        <button onclick="addQuickEvent('Sieste', '🛏️')" class="p-3 bg-indigo-50 border border-indigo-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">🛏️</span>
          <span class="text-xs font-bold text-indigo-900">Sieste</span>
        </button>

        <button onclick="addQuickEvent('Sommeil nuit', '🌙')" class="p-3 bg-blue-50 border border-blue-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">🌙</span>
          <span class="text-xs font-bold text-blue-900">Sommeil Nuit</span>
        </button>

        <button onclick="addQuickEvent('Allaitement', '🤱')" class="p-3 bg-emerald-50 border border-emerald-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">🤱</span>
          <span class="text-xs font-bold text-emerald-900">Allaitement</span>
        </button>

        <button onclick="addQuickEvent('Repas solide', '🥣')" class="p-3 bg-green-50 border border-green-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">🥣</span>
          <span class="text-xs font-bold text-green-900">Solide</span>
        </button>

        <button onclick="addQuickEvent('Couche', '👶')" class="p-3 bg-amber-50 border border-amber-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">👶</span>
          <span class="text-xs font-bold text-amber-900">Couche</span>
        </button>

        <button onclick="addQuickEvent('Divers', '📝')" class="p-3 bg-purple-50 border border-purple-100 rounded-2xl flex flex-col items-center active:scale-95 transition">
          <span class="text-2xl mb-1">📝</span>
          <span class="text-xs font-bold text-purple-900">Divers</span>
        </button>

      </div>
    </section>

    <!-- Historique / Fil d'actualité -->
    <main class="flex-1 p-4 bg-slate-50 border-t border-slate-100">
      <div class="flex justify-between items-center mb-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Historique</h2>
        <div class="space-x-1">
          <button onclick="exportData('csv')" class="text-xs px-2 py-1 bg-white border rounded shadow-sm text-gray-600 font-semibold">CSV</button>
          <button onclick="exportData('json')" class="text-xs px-2 py-1 bg-white border rounded shadow-sm text-gray-600 font-semibold">JSON</button>
        </div>
      </div>

      <!-- Liste dynamique gérée par Firebase -->
      <div id="events-list" class="space-y-2">
        <p class="text-center text-sm text-gray-400 py-6">Chargement des données...</p>
      </div>
    </main>

  </div>

  <!-- Scripts Firebase SDK (v9 Modulaire / Compat) -->
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>

  <script>
    // 1. REMPLACE LES VALEURS CI-DESSOUS PAR CELLES DE TA CONSOLE FIREBASE
    const firebaseConfig = {
      apiKey: "VOTRE_API_KEY",
      authDomain: "VOTRE_PROJECT_ID.firebaseapp.com",
      projectId: "VOTRE_PROJECT_ID",
      storageBucket: "VOTRE_PROJECT_ID.appspot.com",
      messagingSenderId: "VOTRE_NUMERO",
      appId: "VOTRE_APP_ID"
    };

    // Initialisation de Firebase
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    let allEvents = [];

    // 2. Synchronisation en temps réel avec Firebase Firestore
    db.collection("events")
      .orderBy("timestamp", "desc")
      .onSnapshot((snapshot) => {
        allEvents = [];
        const container = document.getElementById("events-list");
        container.innerHTML = "";

        if (snapshot.empty) {
          container.innerHTML = '<p class="text-center text-sm text-gray-400 py-6">Aucun événement enregistré.</p>';
          return;
        }

        snapshot.forEach((doc) => {
          const data = doc.data();
          allEvents.push({ id: doc.id, ...data });

          const dateObj = data.timestamp ? data.timestamp.toDate() : new Date();
          const timeStr = dateObj.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
          const dateStr = dateObj.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });

          const itemHtml = `
            <div class="p-3 bg-white rounded-xl shadow-sm border border-slate-100 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-2xl">${data.icon || '📌'}</span>
                <div>
                  <div class="font-semibold text-gray-800 text-sm">${data.category}</div>
                  <div class="text-xs text-gray-400">${dateStr} à ${timeStr}</div>
                </div>
              </div>
              <button onclick="deleteEvent('${doc.id}')" class="text-gray-300 hover:text-red-500 text-xs p-1">✕</button>
            </div>
          `;
          container.innerHTML += itemHtml;
        });
      });

    // 3. Ajouter un événement rapidement
    function addQuickEvent(category, icon) {
      db.collection("events").add({
        category: category,
        icon: icon,
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
      })
      .then(() => console.log("Événement ajouté !"))
      .catch((error) => alert("Erreur d'enregistrement : " + error.message));
    }

    // 4. Supprimer un événement
    function deleteEvent(id) {
      if (confirm("Supprimer cet événement ?")) {
        db.collection("events").doc(id).delete();
      }
    }

    // 5. Exporter les données (CSV / JSON)
    function exportData(format) {
      if (allEvents.length === 0) {
        alert("Aucune donnée à exporter.");
        return;
      }

      if (format === 'json') {
        const jsonString = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(allEvents, null, 2));
        downloadFile(jsonString, `suivi_bebe_${new Date().toISOString().slice(0,10)}.json`);
      } else if (format === 'csv') {
        const headers = ["ID", "Categorie", "Date_Heure"];
        const rows = allEvents.map(e => [
          e.id,
          `"${e.category}"`,
          `"${e.timestamp ? e.timestamp.toDate().toISOString() : ''}"`
        ]);
        const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
        downloadFile(encodeURI(csvContent), `suivi_bebe_${new Date().toISOString().slice(0,10)}.csv`);
      }
    }

    function downloadFile(content, fileName) {
      const link = document.createElement("a");
      link.setAttribute("href", content);
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      link.remove();
    }

    // Enregistrement du Service Worker pour la PWA
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js').catch(() => {});
    }
  </script>
</body>
</html>
